# ---- Infra (Phase 0) ----
POSTGRES_USER=creditflow
POSTGRES_PASSWORD=creditflow
POSTGRES_DB=creditflow

REDIS_URL=redis://redis:6379
# See docker-compose.yml comment block for logical DB index scheme (0-4)

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

MONGO_URL=mongodb://mongodb:27017/creditflow_scraper

# ---- Auth (Phase 2) ----
JWT_PRIVATE_KEY_PATH=/app/keys/jwt_private.pem   # auth-service only
JWT_PUBLIC_KEY_PATH=/app/keys/jwt_public.pem     # every service that verifies JWTs
INTERNAL_SERVICE_SECRET=dev-only-internal-secret-change-me
# Shared between auth-service and user-service (Phase 4) only — gates
# POST /auth/issue-scoped-token. See docs/ARCHITECTURE.md "Internal
# cross-service calls". Change this value for anything beyond solo local dev.

# ---- API Gateway (Phase 3) ----
LINKEDIN_WEBHOOK_SECRET=
OPENROUTER_WEBHOOK_SECRET=
# LinkedIn/OpenRouter secrets are placeholders — see
# docs/EVENT_CONTRACTS.md "Webhook relay events" section.

# ---- Billing (Phase 5) ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_TEAM=
# Used by BOTH api-gateway (signature verification only, this phase) and
# billing-service (full Stripe SDK usage, Phase 5) — same secret, two
# consumers of it.

# ---- AI Generation (Phase 8) ----
OPENROUTER_API_KEY=sk-or-xxx
HUGGINGFACE_API_KEY=

# ---- Social Publishing (Phase 11) ----
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/social/linkedin/callback
TOKEN_ENCRYPTION_KEY=   # Fernet key for token-at-rest encryption

# ---- Notification (Phase 13) ----
RESEND_API_KEY=
SLACK_WEBHOOK_URL=   # optional ops alerts

# ---- Frontend (Phase 15) ----
VITE_API_BASE_URL=http://localhost:8000